# Copia este archivo a .env y rellena los valores.
# Lo cargan Tienda_Virtual/settings/{base,local,production}.py, y también
# manage.py/wsgi.py/asgi.py/celery.py (antes de decidir qué módulo de settings usar).

# --- Qué settings usar ---
# Sin esta línea, TODO (manage.py, wsgi.py, celery.py) usa
# Tienda_Virtual.settings.production por defecto, que exige DB_*, AWS_* y
# DJANGO_ALLOWED_HOSTS reales (falla explícito si faltan). Para desarrollo
# local, descomenta:
# DJANGO_SETTINGS_MODULE=Tienda_Virtual.settings.local

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Solo settings.production:
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=midominio.com,www.midominio.com
DJANGO_CORS_ALLOWED_ORIGINS=https://midominio.com

# --- Base de datos (MySQL) ---
DB_NAME=tienda
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Celery ---
# En local se puede dejar así y poner CELERY_TASK_ALWAYS_EAGER=True para no
# necesitar Redis ni worker.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- AWS S3 (solo settings.production) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=
