# Copiar a `.env` (junto a docker-compose.yml, en el VPS) y rellenar.
# A diferencia de .env.example (desarrollo local), estos valores asumen que
# MySQL/Redis corren como servicios del propio docker-compose: DB_HOST/las
# URLs de Redis usan los nombres de servicio (db/redis), no localhost.

DJANGO_SETTINGS_MODULE=Tienda_Virtual.settings.production
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ip.del.vps          # sumá tu dominio acá cuando lo tengas
DJANGO_CORS_ALLOWED_ORIGINS=https://tu-frontend.com

# --- HTTPS ---
# Mientras no haya dominio + certbot (nginx solo sirve HTTP), dejar en False/0:
# si no, Django exige redirect a HTTPS y nginx no lo puede cumplir (sitio
# inalcanzable). En cuanto configures certbot (ver DEPLOY.md), quitá estas dos
# líneas (o poné True / 31536000) para recuperar HSTS + redirect a HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# --- Base de datos (contenedor `db` del compose) ---
DB_NAME=tienda
DB_USER=tienda
DB_PASSWORD=elige-una-clave-fuerte
DB_ROOT_PASSWORD=elige-otra-clave-fuerte-distinta
DB_HOST=db
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- Redis / Celery (contenedor `redis` del compose) ---
# DB 0 para el broker de Celery, DB 1 para la caché de inventario: así un
# cache.clear() no toca los mensajes en cola.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CACHE_REDIS_URL=redis://redis:6379/1

# --- AWS S3 (estático + media) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=

# --- gunicorn ---
GUNICORN_WORKERS=3
